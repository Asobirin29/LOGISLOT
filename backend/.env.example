# LogisSlot Environment Configuration Example

# Server Config
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Config (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://logislot:secret123@localhost:5432/logislot?schema=public"

# Redis Config (Session & Cache)
REDIS_URL="redis://localhost:6379"

# Security (JWT)
# Use a strong random string (e.g. from `openssl rand -base64 32`)
JWT_SECRET="ganti_dengan_rahasia_super_kuat_anda_123!"
JWT_REFRESH_SECRET="ganti_dengan_rahasia_refresh_token_super_kuat_456!"
